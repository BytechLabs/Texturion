# /etc/caddy/Caddyfile on the rig.
#
# The three rig names, served only on loopback and on the VM's own VMnet8
# address, where the emulators on the workstation reach them; the VM's
# nftables admits 443 there from the workstation alone. Certificates come
# from the rig's own authority, generated in the VM by
# tools/rig/box/bootstrap.sh and never committed; it is
# name-constrained to rig.internal, so even a stolen key vouches for nothing
# real. Caddy issues and renews the leaf certificates from it.
{
	admin localhost:2019
	auto_https disable_redirects
	pki {
		ca rig {
			name "Loonext Rig CA"
			root {
				cert /etc/loonext-rig/ca/root.crt
				key /etc/loonext-rig/ca/root.key
			}
		}
	}
}

(rig_site) {
	# 192.168.70.10 is static (cloud-init), so it exists before Caddy starts.
	bind 127.0.0.1 192.168.70.10
	tls {
		issuer internal {
			ca rig
		}
	}
	header {
		-Server
	}
}

api.rig.internal {
	import rig_site
	reverse_proxy 127.0.0.1:8787
}

app.rig.internal {
	import rig_site
	reverse_proxy 127.0.0.1:8788
}

db.rig.internal {
	import rig_site
	reverse_proxy 127.0.0.1:54321
}
