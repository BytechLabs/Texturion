# The deployed ref's API under wrangler dev, with the AI shim beside it,
# on 127.0.0.1:8787 (Caddy serves it as api.rig.internal).
#
# Starts after the stack unit and only once it is up. `Requires=` would fail
# this unit for good when the stack's first start failed, even though the stack
# unit retries; `rig stack wait` waits through the retries and fails with a
# reason when the stack gave up.
[Unit]
Description=Loonext rig: API (wrangler dev, rig mode)
Wants=loonext-rig-stack.service
After=loonext-rig-stack.service

[Service]
Environment=RIG_HOME=/var/lib/loonext-rig
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/local/bin/node /var/lib/loonext-rig/tooling/tools/rig/bin/rig.mjs stack wait
ExecStart=/usr/local/bin/node /var/lib/loonext-rig/tooling/tools/rig/bin/rig.mjs serve api
Restart=on-failure
RestartSec=5s
KillMode=mixed
TimeoutStartSec=40min
TimeoutStopSec=20s

[Install]
WantedBy=default.target
