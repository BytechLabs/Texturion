{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loonext-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // #578: this Worker answers on its custom domain and nowhere else.
  //
  // Absent, both of these DEFAULT TO ON, and the difference between "absent" and
  // "false" is that a dashboard toggle survives until the next `wrangler deploy`
  // and this survives everything. The setting has to live in the repo or it
  // lasts one release.
  //
  // `workers_dev` is a second front door with different rules. The host split in
  // `src/lib/hosts.ts` returns null for a host it does not recognise —
  // deliberately, so previews and tunnels are left alone — which means app routes
  // served from `*.workers.dev` skip the marketing/app redirect and the cache
  // rule anchored to a known host in #559. Measured on 2026-08-10 before this
  // landed: this Worker served `/` and `/login` at 200 on its workers.dev name.
  //
  // `preview_urls` is off for the reason it exists: a preview URL keeps a
  // SUPERSEDED build addressable at a stable address after a release. There is
  // one environment here and no staging (docs/ENVIRONMENTS.md), so a preview URL
  // is not a review surface — it is an older bundle nobody is watching, still
  // answering, still holding whatever bug the release fixed.
  "workers_dev": false,
  "preview_urls": false,
  // #118: wrangler's bundler defaults keep_names to true, making esbuild
  // inject __name(...) helper calls into every function — INCLUDING functions
  // whose source gets serialized into inline <script> strings at runtime
  // (next-themes' anti-FOUC theme script reads its own Function.toString()).
  // The helper only exists in the worker module scope, so every page threw
  // "ReferenceError: __name is not defined" in the browser and the
  // pre-hydration theme class was never set (light flash for dark users).
  // Sourcemaps keep worker stack traces readable instead.
  "keep_names": false,
  "upload_source_maps": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // #242: the live /status incident line. Writable from the Cloudflare dashboard
  // with no repo, no CI and no deploy, which is the whole point — the page has to
  // be able to report an outage whose cause IS the deploy pipeline. The namespace
  // id is an identifier, not a credential: reading or writing it needs account
  // credentials, which is why Cloudflare's own docs keep it in this file.
  "kv_namespaces": [
    {
      "binding": "STATUS_FEED",
      "id": "df82ac76ecd343eabd834f3f48e24fb4"
    }
  ],
  // #575: the FIRST rate limiter on this Worker. POST /api/status/subscribe is
  // unauthenticated, and its only obstacle was a honeypot a caller skips by
  // omitting the field.
  //
  // The spend was already bounded — the subscriber list caps at 200 and
  // confirmation emails at 50/day and 1000/month (lib/marketing/status-subscribe)
  // — so this is not about a runaway bill. It is about WHO spends that allowance:
  // without a per-caller limit one script can consume the whole day's 50 and
  // point them at fifty addresses that never asked, and the reputational cost of
  // that lands on the domain every customer notification also goes out from.
  //
  // Namespace ids are account-unique and the api Worker holds 1001-1010, so this
  // starts a separate band rather than risking a collision with the next one added
  // there.
  "ratelimits": [
    {
      "name": "STATUS_SUBSCRIBE_RATE_LIMITER",
      "type": "ratelimit",
      "namespace_id": "2001",
      "simple": { "limit": 3, "period": 60 }
    }
  ]
}
