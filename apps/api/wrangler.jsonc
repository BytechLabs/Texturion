{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loonext-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // #578: this Worker answers on its custom domain and nowhere else.
  //
  // Absent, both of these DEFAULT TO ON, and the difference between "absent" and
  // "false" is that a dashboard toggle survives until the next `wrangler deploy`
  // and this survives everything. The setting has to live in the repo or it
  // lasts one release.
  //
  // `workers_dev` is a second front door with different rules. The host split in
  // `apps/web/src/lib/hosts.ts` returns null for a host it does not recognise —
  // deliberately, so previews and tunnels are left alone — which means app routes
  // served from `*.workers.dev` skip the marketing/app redirect and the cache
  // rule anchored to a known host in #559. Measured on 2026-08-10 before this
  // landed: the api answered 200 on `loonext-api.*.workers.dev/health` and the
  // web Worker served `/` and `/login` at 200 on its own.
  //
  // `preview_urls` is off for the reason it exists: a preview URL keeps a
  // SUPERSEDED build addressable at a stable address after a release. There is
  // one environment here and no staging (docs/ENVIRONMENTS.md), so a preview URL
  // is not a review surface — it is an older bundle nobody is watching, still
  // answering, still holding whatever bug the release fixed.
  "workers_dev": false,
  "preview_urls": false,
  // Observability pinned to match the dashboard so `wrangler deploy` (local and
  // CI) never resets it — Cloudflare's "keep settings consistent across
  // deployments" prompt. Net effect: Workers Logs ON (persisted invocation logs
  // for debugging cron/webhook runs), traces OFF. head_sampling_rate is 1 (100%)
  // — fine at MVP volume; lower it if log volume ever approaches the Paid plan's
  // included allotment.
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "triggers": {
    // Exactly the SPEC §11 schedule set. Each expression maps to its job(s)
    // in src/index.ts CRON_JOBS; src/mount.test.ts asserts this list and that
    // map stay in lockstep, and scheduled() fails loudly on an unmapped cron.
    "crons": [
      "* * * * *", // #388 unanswered-lead escalation (2-min and 5-min rungs)
      "*/5 * * * *", // webhook sweeper
      "*/15 * * * *", // provisioning retry & reconcile (+ §4.4 R3 assignment retry)
      "0 * * * *", // usage re-reporter + 80%/100% usage alerts (hourly)
      "30 * * * *", // sole-prop OTP nudge (hourly)
      "20 * * * *", // contact geocoding backfill (hourly; D25 Nominatim, rate-limited)
      "40 * * * *", // task-address geocoding backfill (hourly; #214 Map fix, rate-limited)
      "25 * * * *", // #457 carrier daily-ceiling warning (hourly; one email/crew/day)
      "0 13 * * *", // registration poller (daily)
      "10 13 * * *", // port reconcile & resume (daily; PORTING.md §5.2)
      "0 14 * * *", // grace & release (daily)
      "0 15 * * *", // subscription reconcile
      "45 15 * * *", // opt-out reconciliation against the carrier list (daily)
      "30 15 * * *", // webhook_events ledger retention (daily)
      // #375: the DO alert-channel canary. Six-hourly rather than hourly
      // because each probe is a billable Sentry event, and a canary that eats
      // the error quota would rate-limit the alarms it exists to protect.
      "15 */6 * * *",
      "50 13 * * 1", // #447 founder digest: tenants projected over revenue (weekly, Mon)
      // #482 response-time recap (monthly, 1st). Its own minute so it never
      // shares a tick with the daily jobs above — this one fans out across
      // every active tenant, and a slow run must not delay grace & release.
      // #477: the synthetic probes. Two-hourly rather than hourly — both are
      // free, but a status page reads the same either way and half the rows is
      // half the retention.
      "5 */2 * * *",
      "35 14 1 * *"
    ]
  },
  "unsafe": {
    "bindings": [
      {
        // SPEC §10 layer 3: the per-company outbound rate limiter, checked at
        // the single dispatch choke point (src/messaging/send.ts) for human
        // sends and auto-sends alike, keyed on company_id. Workers rate
        // limiting only supports periods of 10 or 60 seconds, so the SPEC's
        // "1 msg/s" is expressed as limit=10 per period=10s — the identical
        // average rate, tolerating sub-10s bursts. Local dev/tests run
        // without the binding (it is optional in src/env.ts) → gate skipped.
        "name": "SEND_RATE_LIMITER",
        "type": "ratelimit",
        // Account-unique id for this limiter's namespace.
        "namespace_id": "1001",
        "simple": { "limit": 10, "period": 10 }
      },
      {
        // SPEC §10 DoS posture: the keep-your-number ownership-verification
        // endpoints (routes/text-enablement.ts). Requesting a code makes
        // Telnyx SMS/CALL the target number — one the company has NOT yet
        // proven it owns — and the verify endpoint accepts code guesses, so
        // both are bounded per TARGET NUMBER (the would-be victim): 3 per
        // minute caps the call/SMS-bombing and code-brute-force rate while
        // leaving a legitimate request-then-resend flow untouched. Local
        // dev/tests run without the binding (optional in src/env.ts).
        "name": "VERIFY_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 3, "period": 60 }
      },
      {
        // #214 task enrichment: per-company burst limiter on the Workers AI
        // enrichment endpoint (routes/tasks.ts POST /tasks/enrich), keyed on
        // company_id. Enrichment is a metered AI cost center; a hard monthly cap
        // lives in the DB (company_ai_usage), and this bounds short bursts —
        // 10 per 60s comfortably covers a person promoting several messages in a
        // row while stopping a scripted flood. Optional in src/env.ts → local
        // dev/tests skip the burst gate (the monthly cap still applies).
        "name": "AI_ENRICH_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1003",
        "simple": { "limit": 10, "period": 60 }
      },
      {
        // AI reply suggestions: per-company burst limiter on the composer's
        // suggest endpoint (routes/conversations.ts POST
        // /conversations/:id/reply-suggestions), keyed on company_id. Drafting
        // is a metered AI cost center with a hard monthly cap in the DB
        // (company_ai_usage); this bounds short bursts. 20 per 60s covers a
        // dispatcher working down a full inbox thread by thread while stopping
        // a scripted flood. Optional in src/env.ts → local dev/tests skip the
        // burst gate (the monthly cap still applies).
        "name": "AI_REPLY_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1004",
        "simple": { "limit": 20, "period": 60 }
      },
      {
        // The same AI spend, bounded per MEMBER as well as per company.
        //
        // The monthly caps are a company ceiling, which is right (it is the
        // company's bill), but nothing stopped ONE member spending the whole
        // crew's month: a runaway client, a stuck retry loop, or a stolen token
        // could exhaust every draft and every enrichment for everyone else, and
        // the first anyone knew was the cap alert. Keyed on company + user, and
        // set below the company limit so a single person cannot be the entire
        // burst. Optional in src/env.ts → dev/tests skip it.
        "name": "AI_MEMBER_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1005",
        "simple": { "limit": 8, "period": 60 }
      },
      {
        // Voicemail transcription had NO burst limiter at all, only the monthly
        // cap and the once-per-recording guard. It is the most expensive AI call
        // in the product (a whole audio file, a 20s timeout), so opening one
        // voicemail after another walked straight at the cap with nothing in
        // between. Keyed on company + user.
        "name": "AI_TRANSCRIBE_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1006",
        "simple": { "limit": 6, "period": 60 }
      },
      {
        // #261: the signed-URL mint routes had no rate limit at all, and the
        // egress ledger charged per REQUEST — so any member could spend the
        // whole workspace's period download allowance by looping one
        // attachment, leaving everybody on 402 until the period rolled. The
        // ledger is per object now, which removes the cost; this bounds the
        // request rate so the lookups and claim RPCs behind each mint cannot be
        // a flood either. Keyed on company + user. 120/min is far above opening
        // a thread with a full gallery and scrolling it hard, and far below a
        // script. Optional in src/env.ts → dev/tests skip it.
        "name": "ATTACHMENT_URL_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1007",
        "simple": { "limit": 120, "period": 60 }
      },
      {
        // #335: the public-link surface. These endpoints sit OUTSIDE every gate
        // that protects /v1 — no JWT, no company context — and are reachable by
        // anyone who finds or guesses a URL. Keyed on the caller's IP, because
        // there is no account to key on; that is the whole point of the
        // surface. 30/min is generous for a homeowner opening a quote and
        // reloading it, and far below a script walking the keyspace.
        "name": "PUBLIC_LINK_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1008",
        "simple": { "limit": 30, "period": 60 }
      },
      {
        // #513: the number picker's own limiter.
        //
        // It used to borrow VERIFY_RATE_LIMITER, which is 3 per minute. That
        // number is right for what it was built for — an OTP send costs money
        // and a resend loop is an attack — and completely wrong here. Browsing
        // for a phone number is a person reading a list and asking for another
        // one; three refreshes is a normal thirty seconds of shopping, and the
        // fourth told them to come back later.
        //
        // A search costs us nothing but a Telnyx read, so this is sized to
        // stop a script rather than to ration a customer. Keyed per caller.
        "name": "NUMBER_SEARCH_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1009",
        "simple": { "limit": 30, "period": 60 }
      },
      {
        // #251: the same searches, bounded ACROSS the whole account.
        //
        // The limiter above bounds one caller. It does nothing about the fleet,
        // because two customers shopping in the same second are not one caller
        // — and Telnyx's number-management bucket is shared by everybody.
        //
        // Measured 2026-08-19 (scripts/ops/telnyx-rate-limits.mjs): 5 requests
        // per second on /v2/phone_numbers, which is the tightest bucket we
        // touch anywhere. Five concurrent shoppers is a plausible Tuesday.
        //
        // Workers rate limiting only offers periods of 10 or 60 seconds, so
        // 5/s is expressed as 40 per 10s rather than 50: the same bucket also
        // carries number ORDERING, and somebody completing a purchase must not
        // be refused because other people are browsing. The ten we leave on the
        // table are for them.
        //
        // Keyed on a CONSTANT — that is what makes it account-wide.
        "name": "NUMBER_SEARCH_FLEET_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1013",
        "simple": { "limit": 40, "period": 10 }
      },
      {
        // #248: the contact importers (CSV and vCard), keyed on COMPANY.
        //
        // Import is the one route where a customer hands us unbounded input.
        // The row cap and the byte cap bound a single request; nothing bounded
        // how many requests, so 2000 rows of reads-plus-upserts could be
        // replayed as fast as the network allowed.
        //
        // SIX A MINUTE, because three contradicted our own instructions: the
        // wizard tells a workspace with more than 2000 rows to split the file
        // and import it in parts, and an 8000-row book is four parts — the
        // fourth of which was refused, on somebody's first day, by a limit
        // meant for scripts. Six covers a 12,000-row book uploaded back to
        // back and still makes a fan-out of hundreds of thousands take hours.
        // A limit that punishes the behaviour the product asked for is a bug
        // wherever the number is written.
        "name": "CONTACT_IMPORT_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1010",
        "simple": { "limit": 6, "period": 60 }
      },
      {
        // #581/#586: the checkout burst limit, keyed on IP.
        //
        // SPEC.md has promised "Cloudflare WAF rate-limiting rule on
        // /v1/billing/checkout (10 req/min/IP)" for months. Measured on
        // 2026-08-09: 40 back-to-back POSTs from one IP, 39 x 401 and one
        // connection reset, no 429 at any point. The rule was not there.
        //
        // The lesson is not the missing rule, it is that nobody could tell. A
        // control configured only in a dashboard cannot be read from a clone,
        // reviewed in a diff, or tested — a documented protection and an absent
        // one look the same from the repo. This binding is none of those things.
        //
        // 10/60s is the number the spec already published.
        "name": "CHECKOUT_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1011",
        "simple": { "limit": 10, "period": 60 }
      },
      {
        // #243 item 4: the public API's per-KEY ceiling. "An integration that
        // polls every second must cost the workspace something or it costs
        // us."
        //
        // Keyed on the api_key id rather than the company, deliberately: one
        // runaway connector must not be able to starve the workspace's other
        // integrations, so the blast radius of a bad script is the script.
        //
        // 60/60s is generous for anything event-driven — a connector needing
        // more than one request a second is polling, and polling is what the
        // webhooks in this same issue exist to replace. Local dev/tests run
        // without the binding (optional in src/env.ts) → the gate is skipped,
        // which is safe because this bounds COST rather than authority.
        "name": "PUBLIC_API_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1012",
        "simple": { "limit": 60, "period": 60 }
      }
    ]
  },
  // #214 task enrichment: Cloudflare Workers AI. The enrichment endpoint runs
  // the cheapest text model (@cf/meta/llama-3.2-1b-instruct) to extract a
  // structured address + due date/time from task text. Optional in src/env.ts —
  // absent (local dev/tests) the endpoint returns "no enrichment".
  "ai": { "binding": "AI" },
  // Calls v3 (#170, docs/CALLS-V3.md §2.1): one CallSessionDO per inbound call
  // session owns the ring/answer/voicemail state machine, serialized by an
  // explicit per-object FIFO. SQLite-backed storage (Workers Paid — already
  // provisioned). The class is resolved from src/index.ts's NAMED export
  // (wrangler reads DO classes from `main`'s named exports, not the
  // Sentry-wrapped default).
  "durable_objects": {
    "bindings": [{ "name": "CALL_SESSIONS", "class_name": "CallSessionDO" }]
  },
  "migrations": [{ "tag": "calls-v3-1", "new_sqlite_classes": ["CallSessionDO"] }],
  // Only non-secret plain-text configuration belongs in "vars". Every credential
  // this Worker needs (SPEC §10) is a Worker encrypted secret — `wrangler secret put`
  // in production, `.dev.vars` locally. See .dev.vars.example for the full list,
  // including the billing bindings (API_ORIGIN, RESEND_FROM, the
  // STRIPE_*_PRICE_ID set printed by `pnpm stripe:setup`, and
  // STRIPE_SMS_METER_EVENT_NAME) and the §8 Web Push VAPID pair
  // (VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY) — kept as secrets alongside the
  // rest so the whole binding set has one injection path from GitHub Actions
  // (SPEC §10).
  "vars": {}
}
