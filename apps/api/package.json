{
  "name": "@loonext/api",
  "version": "0.17.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:load": "vitest run --config vitest.load.config.ts",
    "test:capacity-deployed": "vitest run --config scripts/vitest.capacity.config.ts",
    "capacity:deployed": "node --experimental-strip-types scripts/deployed-capacity.ts",
    "stripe:setup": "node --experimental-strip-types scripts/stripe-setup.ts",
    "test:workerd": "vitest run --config vitest.workerd.config.ts"
  },
  "dependencies": {
    "@loonext/shared": "workspace:*",
    "@sentry/cloudflare": "10.71.0",
    "@supabase/supabase-js": "2.112.4",
    "hono": "^4.13.5",
    "jose": "6.2.10",
    "stripe": "22.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "^4.20260701.1",
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9",
    "wrangler": "^4.106.0"
  }
}
