{
  "name": "@loonext/api",
  "version": "0.29.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:load": "vitest run --config vitest.load.config.ts",
    "test:capacity-deployed": "vitest run --config scripts/vitest.capacity.config.ts",
    "capacity:deployed": "node --experimental-strip-types scripts/deployed-capacity.ts",
    "capacity:rig": "node --experimental-strip-types scripts/rig-capacity.ts",
    "test:rig": "vitest run --config vitest.rig.config.ts",
    "stripe:setup": "node --experimental-strip-types scripts/stripe-setup.ts",
    "test:workerd": "vitest run --config vitest.workerd.config.ts"
  },
  "dependencies": {
    "@loonext/shared": "workspace:*",
    "@supabase/supabase-js": "2.119.0",
    "hono": "^4.13.16",
    "jose": "6.2.15",
    "posthog-node": "5.61.2",
    "stripe": "23.1.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12",
    "wrangler": "^4.157.0"
  }
}
